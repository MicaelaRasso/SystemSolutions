# Supabase Auth and Edge Functions (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Function runtime (server-only; never expose these to the browser)
ALLOWED_ORIGINS=http://localhost:3000
# Legacy single-origin compatibility setting:
# ALLOWED_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Used only if the application adds direct JWT verification.
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Hosted Supabase functions may provide these as JSON maps instead:
# SUPABASE_PUBLISHABLE_KEYS={"default":"sb_publishable_..."}
# SUPABASE_SECRET_KEYS={"default":"sb_secret_..."}

# Optional backup-export safeguards.
# BACKUP_MAX_ARCHIVE_BYTES=524288000
# BACKUP_MAX_DURATION_MS=120000
